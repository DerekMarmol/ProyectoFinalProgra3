@model IEnumerable<SuperBodega.AdminWeb.Models.SupplierViewModel>

@{
    ViewData["Title"] = "Proveedores";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            <i class="fas fa-truck me-2"></i>Proveedores
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-2"></i>Nuevo Proveedor
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th scope="col" class="text-center" style="width: 60px;">ID</th>
                        <th scope="col">Empresa</th>
                        <th scope="col">Contacto</th>
                        <th scope="col">Email</th>
                        <th scope="col">Teléfono</th>
                        <th scope="col">Dirección</th>
                        <th scope="col" class="text-center" style="width: 200px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center align-middle">@item.Id</td>
                            <td class="fw-bold align-middle">
                                <i class="fas fa-building me-1 text-secondary"></i>@item.Name
                            </td>
                            <td class="align-middle">@item.ContactName</td>
                            <td class="align-middle">
                                <a href="mailto:@item.Email" class="text-decoration-none">
                                    <i class="fas fa-envelope me-1 text-primary"></i>@item.Email
                                </a>
                            </td>
                            <td class="align-middle">
                                <i class="fas fa-phone me-1 text-success"></i>@item.Phone
                            </td>
                            <td class="align-middle text-truncate" style="max-width: 200px;">
                                <i class="fas fa-map-marker-alt me-1 text-danger"></i>@item.Address
                            </td>
                            <td class="text-center align-middle">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-2">
                                        <i class="fas fa-edit me-1"></i>Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash-alt me-1"></i>Eliminar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @if (!Model.Any())
    {
        <div class="alert alert-info mt-4">
            <i class="fas fa-info-circle me-2"></i>
            No hay proveedores registrados. ¡Crea uno nuevo para comenzar!
        </div>
    }
</div>