@model SuperBodega.AdminWeb.Models.SupplierViewModel

@{
    ViewData["Title"] = "Eliminar Proveedor";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-trash-alt me-2"></i>Confirmar Eliminación
                    </h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>¿Está seguro que desea eliminar este proveedor?</strong>
                        <p class="mb-0 mt-2">Esta acción no se puede deshacer y podría afectar a los productos asociados.</p>
                    </div>

                    <div class="card bg-light mb-4">
                        <div class="card-body">
                            <h5 class="card-title mb-3 border-bottom pb-2">
                                <i class="fas fa-building me-2"></i>@Model.Name
                            </h5>
                            <dl class="row mb-0">
                                <dt class="col-sm-4">ID:</dt>
                                <dd class="col-sm-8">@Model.Id</dd>
                                
                                <dt class="col-sm-4">Contacto:</dt>
                                <dd class="col-sm-8 fw-bold">@Model.ContactName</dd>
                                
                                <dt class="col-sm-4">Email:</dt>
                                <dd class="col-sm-8">
                                    <a href="mailto:@Model.Email"><i class="fas fa-envelope me-1"></i>@Model.Email</a>
                                </dd>
                                
                                <dt class="col-sm-4">Teléfono:</dt>
                                <dd class="col-sm-8">
                                    <i class="fas fa-phone me-1"></i>@Model.Phone
                                </dd>
                                
                                <dt class="col-sm-4">Dirección:</dt>
                                <dd class="col-sm-8">
                                    <i class="fas fa-map-marker-alt me-1"></i>@Model.Address
                                </dd>
                            </dl>
                        </div>
                    </div>
                    
                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash-alt me-2"></i>Eliminar Permanentemente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>