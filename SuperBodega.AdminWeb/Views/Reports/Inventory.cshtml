@model SuperBodega.AdminWeb.Models.Reports.InventoryReportViewModel
@{
    ViewData["Title"] = "Reporte de Inventario";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            <i class="fas fa-boxes me-2"></i>Reporte de Inventario
        </h1>
        <a href="@Url.Action("Index", "Reports")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>

    <!-- Resumen General -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title">Total Productos</h6>
                            <h4>@Model.TotalProducts</h4>
                        </div>
                        <i class="fas fa-box fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title">Valor Total</h6>
                            <h4>@Model.TotalInventoryValue.ToString("C")</h4>
                        </div>
                        <i class="fas fa-dollar-sign fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title">Stock Bajo</h6>
                            <h4>@Model.LowStockProducts</h4>
                        </div>
                        <i class="fas fa-exclamation-triangle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title">Sin Stock</h6>
                            <h4>@Model.OutOfStockProducts</h4>
                        </div>
                        <i class="fas fa-times-circle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficos -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Inventario por Categoría</h5>
                </div>
                <div class="card-body">
                    <canvas id="categoryInventoryChart" height="300"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Estado del Stock</h5>
                </div>
                <div class="card-body">
                    <canvas id="stockStatusChart" height="300"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Productos con Stock Bajo -->
    @if (Model.LowStockItems.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-warning">
                        <h5 class="mb-0">
                            <i class="fas fa-exclamation-triangle me-2"></i>Productos con Stock Bajo
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Categoría</th>
                                        <th>Proveedor</th>
                                        <th>Stock Actual</th>
                                        <th>Precio</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.LowStockItems)
                                    {
                                        <tr class="@(item.CurrentStock == 0 ? "table-danger" : "table-warning")">
                                            <td>
                                                <strong>@item.ProductName</strong>
                                            </td>
                                            <td>@item.CategoryName</td>
                                            <td>@item.SupplierName</td>
                                            <td>
                                                <span class="badge @(item.CurrentStock == 0 ? "bg-danger" : "bg-warning")">
                                                    @item.CurrentStock
                                                </span>
                                            </td>
                                            <td>@item.Price.ToString("C")</td>
                                            <td>
                                                <a href="@Url.Action("Edit", "Products", new { id = item.ProductId })" class="btn btn-sm btn-primary">
                                                    <i class="fas fa-edit"></i> Editar
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Top Productos por Valor -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Top 10 - Mayor Valor en Inventario</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Posición</th>
                                    <th>Producto</th>
                                    <th>Categoría</th>
                                    <th>Stock</th>
                                    <th>Precio Unitario</th>
                                    <th>Valor Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int position = 1; }
                                @foreach (var product in Model.TopValueProducts)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-secondary">#@position</span>
                                        </td>
                                        <td>
                                            <strong>@product.ProductName</strong>
                                        </td>
                                        <td>@product.CategoryName</td>
                                        <td>@product.Stock</td>
                                        <td>@product.UnitPrice.ToString("C")</td>
                                        <td>
                                            <strong class="text-success">@product.TotalValue.ToString("C")</strong>
                                        </td>
                                    </tr>
                                    position++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Gráfico de inventario por categoría
        const categoryInventoryCtx = document.getElementById('categoryInventoryChart').getContext('2d');
        const categoryInventoryChart = new Chart(categoryInventoryCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.InventoryByCategory.Select(c => c.CategoryName))),
                datasets: [{
                    label: 'Valor de Inventario',
                    data: @Html.Raw(Json.Serialize(Model.InventoryByCategory.Select(c => c.TotalValue))),
                    backgroundColor: 'rgba(54, 162, 235, 0.8)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return '$' + value.toLocaleString();
                            }
                        }
                    }
                }
            }
        });

        // Gráfico de estado del stock
        const inStock = @Model.TotalProducts - @Model.LowStockProducts - @Model.OutOfStockProducts;
        const stockStatusCtx = document.getElementById('stockStatusChart').getContext('2d');
        const stockStatusChart = new Chart(stockStatusCtx, {
            type: 'doughnut',
            data: {
                labels: ['En Stock', 'Stock Bajo', 'Sin Stock'],
                datasets: [{
                    data: [inStock, @Model.LowStockProducts, @Model.OutOfStockProducts],
                    backgroundColor: [
                        '#28a745',
                        '#ffc107',
                        '#dc3545'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    </script>
}