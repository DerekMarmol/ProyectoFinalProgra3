@model IEnumerable<SuperBodega.AdminWeb.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Categorías";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            <i class="fas fa-tags me-2"></i>Categorías
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-2"></i>Crear Nueva
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th scope="col" class="text-center" style="width: 80px;">ID</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Descripción</th>
                        <th scope="col" class="text-center" style="width: 200px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.Id</td>
                            <td class="fw-bold">@item.Name</td>
                            <td>
                                @if (string.IsNullOrEmpty(item.Description))
                                {
                                    <span class="text-muted fst-italic">Sin descripción</span>
                                }
                                else
                                {
                                    @item.Description
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-2">
                                        <i class="fas fa-edit me-1"></i>Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash-alt me-1"></i>Eliminar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @if (!Model.Any())
    {
        <div class="alert alert-info mt-4">
            <i class="fas fa-info-circle me-2"></i>
            No hay categorías registradas. ¡Crea una nueva para comenzar!
        </div>
    }
</div>