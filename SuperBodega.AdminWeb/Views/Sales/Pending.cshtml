@model IEnumerable<SuperBodega.AdminWeb.Models.SaleViewModel>
@{
    ViewData["Title"] = "Ventas Pendientes";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            <i class="fas fa-clock me-2 text-warning"></i>Ventas Pendientes
        </h1>
        <div>
            <a href="@Url.Action("Index", "Sales")" class="btn btn-outline-primary">
                <i class="fas fa-list me-2"></i>Ver Todas
            </a>
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Volver
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="alert alert-warning" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>@Model.Count() ventas</strong> necesitan ser procesadas
        </div>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-warning">
                        <tr>
                            <th>ID</th>
                            <th>Referencia</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th>Total</th>
                            <th>Tiempo Pendiente</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sale in Model.OrderBy(s => s.SaleDate))
                        {
                            <tr class="table-warning">
                                <td>@sale.Id</td>
                                <td>
                                    <code>@sale.Reference</code>
                                </td>
                                <td>
                                    <strong>@sale.CustomerName</strong>
                                </td>
                                <td>@sale.SaleDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <strong class="text-success">@sale.TotalAmount.ToString("C")</strong>
                                </td>
                                <td>
                                    @{
                                        var timeSpan = DateTime.Now - sale.SaleDate;
                                        string timeText = "";
                                        if (timeSpan.TotalDays >= 1)
                                        {
                                            timeText = $"{(int)timeSpan.TotalDays} días";
                                        }
                                        else if (timeSpan.TotalHours >= 1)
                                        {
                                            timeText = $"{(int)timeSpan.TotalHours} horas";
                                        }
                                        else
                                        {
                                            timeText = $"{(int)timeSpan.TotalMinutes} minutos";
                                        }
                                    }
                                    <span class="badge @(timeSpan.TotalDays > 1 ? "bg-danger" : "bg-warning")">
                                        @timeText
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a href="@Url.Action("Details", "Sales", new { id = sale.Id })" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> Ver
                                        </a>
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            <input type="hidden" name="saleId" value="@sale.Id" />
                                            <input type="hidden" name="newStatus" value="1" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="fas fa-play"></i> Procesar
                                            </button>
                                        </form>
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            <input type="hidden" name="saleId" value="@sale.Id" />
                                            <input type="hidden" name="newStatus" value="4" />
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Está seguro de cancelar esta venta?')">
                                                <i class="fas fa-times"></i> Cancelar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-check-circle fa-5x text-success mb-4"></i>
            <h3>¡Excelente!</h3>
            <p class="lead text-muted">No hay ventas pendientes de procesar</p>
            <a href="@Url.Action("Index", "Sales")" class="btn btn-primary">
                <i class="fas fa-list me-2"></i>Ver Todas las Ventas
            </a>
        </div>
    }
</div>
